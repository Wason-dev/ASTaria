node_modules
dist
dist-ssr
dist-mobile/
dev-dist
*.local
.DS_Store
npm-debug.log*
yarn-error.log*

# DeepSeek Harness dispatch state: local audit chain and signing identity.
# These files are machine-specific and must never enter the repository.
.dsh-dispatch/
.dsh-queue/
desktop-builds/
.env
.env.*
!.env.example
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal

# Local review captures and raster design references are not distributable sources.
artifacts/
design/**/*.png

# Local planning and publication records.
.local-publication/
/PROJECT_ROADMAP.md
PUBLIC_READINESS.md
BETA_REVIEW.md
FIRST_BETA_PLAN.md
design/icon-generator.html
design/icon-pairwise-reference.svg

# Native mobile build output, local SDK paths, signing and provisioning.
mobile/android/.gradle/
mobile/android/.idea/
mobile/android/local.properties
mobile/android/**/build/
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor*.json
mobile/ios/App/App/public/
mobile/ios/App/App/capacitor.config.json
mobile/ios/App/**/xcuserdata/
mobile/ios/App/build/
mobile/ios/DerivedData/
*.xcuserstate
*.mobileprovision
*.p12
*.jks
*.keystore

# Optional 4K video pack remains local until a separate resource publication.
/media-assets/
/.mobile-build/

# Maintainer-only planning, implementation notes, and local release evidence.
/ASSET_PROVENANCE.md
/design/icon/**/README.md
# Public user documentation is limited to the reviewed user guides, release
# notes, and README screenshots; other docs/ content stays local and untracked.
# Parent directories must be re-included before their contents: Git does not
# descend into an ignored directory, so files inside could not be un-ignored.
/docs/*
!/docs/guides/
/docs/guides/*
!/docs/guides/FEATURES.md
!/docs/guides/INSTALL.md
!/docs/releases/
/docs/releases/*
!/docs/releases/README.md
!/docs/releases/v[0-9]*.md
!/docs/releases/history/
/docs/releases/history/*
!/docs/releases/history/v[0-9]*.md
!/docs/images/
/docs/images/*
!/docs/images/*.png
/public/backgrounds/README.md
