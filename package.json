{
  "name": "astaria",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode design-preview",
    "build:desktop": "tsc --noEmit && vite build --mode desktop && node scripts/verify-bundled-media.mjs dist",
    "build:mobile": "tsc --noEmit -p tsconfig.mobile.json && vite build --mode mobile && node scripts/verify-bundled-media.mjs dist-mobile",
    "dev:mobile": "vite --mode mobile",
    "sync:mobile": "npm run build:mobile && cap sync && npm run verify:mobile-payload",
    "doctor:mobile": "node scripts/mobile-doctor.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs mobile/runtime/*.test.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "verify:mobile-payload": "node scripts/verify-mobile-payload.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@noble/hashes": "2.4.0",
    "@types/three": "^0.186.0",
    "dexie": "^4.4.6",
    "fflate": "0.8.3",
    "gsap": "3.15.0",
    "htmlparser2": "^10.0.0",
    "katex": "0.19.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sql.js": "1.14.2",
    "three": "^0.186.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "resedit": "3.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
