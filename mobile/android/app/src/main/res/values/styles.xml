<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/astaria_launch_background</item>
        <item name="android:statusBarColor">#050506</item>
        <item name="android:navigationBarColor">#050506</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#050506</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#050506</item>
        <item name="android:navigationBarColor">#050506</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <!-- AndroidX's existing theme and the system splash need no Capacitor SplashScreen plugin. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/astaria_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/astaria_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/astaria_launch_background</item>
        <item name="android:statusBarColor">@color/astaria_launch_background</item>
        <item name="android:navigationBarColor">@color/astaria_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
